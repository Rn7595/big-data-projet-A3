# Copier en .env :  cp .env.example .env
# Le fichier .env est ignore par git (identifiants locaux uniquement, jamais de secret reel).

# ---------- Phase 1 : Oracle ----------
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1
ORACLE_USER=ecom
ORACLE_PASSWORD=ecom
ORACLE_SYS_PASSWORD=oracle

# ---------- Phase 2 : Cassandra ----------
CASSANDRA_HOST=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=ecommerce
CASSANDRA_CLUSTER=bigdata-ecommerce

# ---------- Phase 4 : Elasticsearch / Kibana ----------
ES_HOST=http://localhost:9200
ES_PORT=9200
KIBANA_URL=http://localhost:5601
KIBANA_PORT=5601
ES_INDEX_ITEMS=ecom-order-items
ES_INDEX_CUSTOMERS=ecom-customers

# ---------- Volumetrie du jeu de donnees genere ----------
NB_CUSTOMERS=5000
NB_PRODUCTS=800
NB_ORDERS=60000
SEED=42
